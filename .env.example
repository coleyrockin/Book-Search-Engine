# MongoDB connection string (defaults to local if not set)
MONGODB_URI=mongodb://127.0.0.1:27017/googlebooks

# JWT settings. Required; use at least 32 random characters.
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRATION=2h

# Optional browser origin for cross-origin local development
CLIENT_ORIGIN=http://localhost:3000

# Server port (defaults to 3001)
PORT=3001

# GraphQL abuse throttling
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Optional seed behavior. Set to true only when you want to clear every user.
SEED_CLEAR_ALL=false
